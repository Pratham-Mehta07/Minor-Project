# Copy to backend/.env and adjust. Never commit the real .env file.
# Relative paths are resolved against the project root, not the current
# working directory, so the same values work on Windows, Colab and Kaggle.

# Trained weights promoted from a training run (see models/README.md)
YOLO_MODEL_PATH=models/best.pt

# Optional explicit version label stored with every analysis.
# Leave empty to derive it from models/best.json or the weights file hash.
MODEL_VERSION=

# Inference settings
# 0.35 = where mean F1 peaks on the test set for the current model (see runs/evaluate/*/BoxF1_curve.png)
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.70
INFERENCE_IMAGE_SIZE=640
# auto = first CUDA GPU if available, otherwise CPU. Also accepts cpu, 0, 1, ...
DEVICE=auto

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# PostgreSQL, e.g. postgresql+psycopg://wastewise:<password>@localhost:5432/wastewise
# Leave empty to run inference without persistence.
DATABASE_URL=

LOG_LEVEL=INFO
